{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ev-nrg",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "observability": { "enabled": true },
  // public/ is served as static files; only /api runs the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ev-nrg",
      "database_id": "c05d3274-9d30-4e19-bbf9-36ad2bddaa67"
    }
  ]
}
